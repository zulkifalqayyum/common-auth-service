# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=8000

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nordjay
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# ==============================
# Redis (token revocation / cache)
# ==============================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_SENTINELS=localhost:26379,localhost:26380
REDIS_MASTER_NAME=mymaster
REDIS_TOKEN_DB=0
REDIS_API_KEY_DB=4

# If true, auth requests fail closed (401) when Redis is unreachable.
# If false, auth requests fail open (skip revocation check) when Redis is unreachable.
REDIS_FAIL_CLOSED=true

# ==============================
# JWT / Sessions
# This MUST match the Django SECRET_KEY if you need cross-system token verification.
# ==============================
JWT_SECRET=change-me-to-a-long-random-secret-shared-with-django
JWT_ISSUER=nordjay
JWT_AUDIENCE=nordjay-clients
ACCESS_TOKEN_TTL_SECONDS=28800
REFRESH_TOKEN_TTL_SECONDS=43200
MFA_PRE_CHALLENGE_TTL_SECONDS=600

# ==============================
# Cookies
# ==============================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SESSION_COOKIE_NAME=session
REFRESH_COOKIE_NAME=refresh_token
MFA_COOKIE_NAME=mfa_pre_challenge

# ==============================
# CORS
# ==============================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================
# API Keys
# ==============================
API_KEY_PREFIX=ak_live_

# ==============================
# Bcrypt
# ==============================
BCRYPT_SALT_ROUNDS=12
